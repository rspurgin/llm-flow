{
  "name": "llm-flow",
  "version": "0.1.0",
  "description": "MCP server + CLI that lets LLMs generate business-language flowcharts from code",
  "type": "module",
  "bin": {
    "llm-flow": "./dist/cli.js",
    "llm-flow-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "node build.mjs",
    "dev": "tsc --watch",
    "start:mcp": "node bundle/server.cjs",
    "start:cli": "node bundle/cli.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "openai": "^4.103.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "flowchart",
    "llm",
    "claude",
    "codex",
    "cursor",
    "diagram",
    "code-documentation"
  ],
  "license": "MIT"
}
